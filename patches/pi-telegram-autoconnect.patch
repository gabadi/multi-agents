+// ── Fabric Registry Lock ─────────────────────────────────────────────
+// Prevents multiple pi sessions from polling the same Telegram bot.
+// Uses the Fabric agent registry (SQLite) as the single source of truth.
+
+const FABRIC_REGISTRY = process.env.FABRIC_REGISTRY_DB ?? "/tmp/fabric-agents/registry.sqlite";
+
+function isPidAlive(pid: number): boolean {
+	try { process.kill(pid, 0); return true; } catch { return false; }
 }
 
+function ensureLockTable(db: DatabaseSync): void {
+	db.exec(`
+		CREATE TABLE IF NOT EXISTS telegram_owner (
+			agent_id TEXT PRIMARY KEY,
+			pid INTEGER NOT NULL,
+			connected_at TEXT DEFAULT (datetime('now'))
+		);
+	`);
+}
+
+function getTelegramLock(): { agent_id: string; pid: number } | null {
+	if (!existsSync(FABRIC_REGISTRY)) return null;
+	try {
+		const db = new DatabaseSync(FABRIC_REGISTRY);
+		ensureLockTable(db);
+		const row = db.prepare("SELECT agent_id, pid FROM telegram_owner LIMIT 1").get() as { agent_id: string; pid: number } | undefined;
+		db.close();
+		if (row && isPidAlive(row.pid)) return row;
+		// Stale lock – clean it up
+		if (row) releaseTelegramLock(row.agent_id);
+		return null;
+	} catch {
+		return null;
+	}
+}
+
+function acquireTelegramLock(agentId: string, pid: number): boolean {
+	if (!existsSync(FABRIC_REGISTRY)) return true; // no registry = no contention, allow
+	try {
+		const db = new DatabaseSync(FABRIC_REGISTRY);
+		ensureLockTable(db);
+		const existing = db.prepare("SELECT agent_id, pid FROM telegram_owner LIMIT 1").get() as { agent_id: string; pid: number } | undefined;
+		if (existing) {
+			if (isPidAlive(existing.pid) && existing.pid !== pid) {
+				db.close();
+				return false;
+			}
+			// stale or own lock – replace
+			db.prepare("DELETE FROM telegram_owner").run();
+		}
+		db.prepare("INSERT INTO telegram_owner (agent_id, pid) VALUES (?, ?)").run(agentId, pid);
+		db.close();
+		return true;
+	} catch {
+		return true; // if DB fails, don't block Telegram
+	}
+}
+
+function releaseTelegramLock(agentId?: string): void {
+	if (!existsSync(FABRIC_REGISTRY)) return;
+	const id = agentId ?? process.env.PI_AGENT_ID ?? "unknown";
+	try {
+		const db = new DatabaseSync(FABRIC_REGISTRY);
+		db.prepare("DELETE FROM telegram_owner WHERE agent_id = ?").run(id);
+		db.close();
+	} catch {
+		// ignore cleanup errors
+	}
+}
